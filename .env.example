# Restricted API key (rk_...) is preferred. A secret key (sk_...) also works.
# Never commit real values. Put them in .env or the host secrets store.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional absolute origin for Checkout return URLs, such as https://ogvault.example
# When unset, return URLs use the browser origin if it is this local site.
# When set, Discord's redirect URI is {APP_ORIGIN}/api/auth/discord/callback.
APP_ORIGIN=

# Discord OAuth2 (identify only). Do not commit real values.
# Register every URL you use in the Discord developer portal.
# Local API, when APP_ORIGIN is unset:
#   http://127.0.0.1:8787/api/auth/discord/callback
# Production when APP_ORIGIN is https://ogvault.co.uk:
#   https://ogvault.co.uk/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Public client id baked into the Vite build so the Discord button can leave
# for discord.com even when this host has no API. The production build copies
# DISCORD_CLIENT_ID when this is unset. Never put the client secret here.
VITE_DISCORD_CLIENT_ID=

# Used only to look up the review channel id. The bot posts the review.
# Never commit a real URL.
DISCORD_DISPUTE_WEBHOOK_URL=
# Fallback channel id when the webhook lookup fails. Never commit a real id.
DISCORD_REVIEW_CHANNEL_ID=

# Gateway bot for guild slash commands (tournament, ban, unban, matchmaking, reviewer, tokens).
# Bot token from the Discord developer portal Bot page. Never commit it.
# Guild id is the Discord server id (developer mode, right-click the server).
# Admin ids are Discord user ids, comma-separated. Empty rejects every command.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_IDS=
